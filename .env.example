# 라이트닝 지갑 연동 (트랙 B — 목표 달성 자동 판정용)
# 이 파일을 .env 로 복사해 채우세요. (.env는 gitignore됨)
#
# check-goal은 아래 순서로 공급자를 자동 판별합니다: Coinos → Blink → LNbits

# ── Coinos (2026-08-16 기본 선택지) ──
# coinos.io 가입 → 사용자명+비밀번호만 필요 (전화번호·이메일·KYC 없음)
# 토큰: 로그인 후 coinos.io/docs 페이지에서 확인, 또는 POST /api/login 응답
#
# ⚠ 이 토큰은 계정 전체 권한입니다 (Blink의 Read 스코프 키와 다름).
#   커스터디얼 잔고는 소액만 유지하세요 — docs/SECURITY.md
COINOS_TOKEN=
# 기본 엔드포인트 사용 시 비워두면 됨 (https://coinos.io/api)
COINOS_ENDPOINT=

# ── Blink (한국 번호는 온보딩 불가 — 2026-08-16 확인) ──
BLINK_API_KEY=
BLINK_ENDPOINT=

# ── LNbits (대안) ──
LNBITS_URL=
LNBITS_READ_KEY=
